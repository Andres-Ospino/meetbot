# Puerto del servidor API
PORT=8080

# Token Bearer para proteger la API (dejar vacío para desarrollo abierto)
MEETBOT_API_KEY=

# Dirección de depuración CDP de Chrome
MEETBOT_CDP_ADDR=localhost:9222

# Carpeta local para almacenar grabaciones temporales
MEETBOT_ARTIFACTS_DIR=./recordings

# Proveedor de IA Opcional (OpenAI / Ollama / Gemini)
MEETBOT_AI_API_KEY=
MEETBOT_AI_BASE_URL=https://api.openai.com/v1
MEETBOT_AI_MODEL=gpt-4o-mini
